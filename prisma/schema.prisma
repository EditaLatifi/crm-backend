model VacationRequest {
  id               String         @id @default(uuid())
  userId           String
  user             User           @relation("VacationRequests", fields: [userId], references: [id])
  startDate        DateTime
  endDate          DateTime
  days             Int
  type             VacationType   @default(VACATION)
  status           VacationStatus @default(PENDING)
  note             String?
  adminNote        String?
  reviewedByUserId String?
  reviewedBy       User?          @relation("VacationReviewer", fields: [reviewedByUserId], references: [id])
  reviewedAt       DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
}

enum VacationType {
  VACATION
  SICK
  UNPAID
  MILITARY_SERVICE
  OTHER
}

enum VacationStatus {
  PENDING
  APPROVED
  REJECTED
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation("PasswordResetTokens", fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([token])
  @@index([expiresAt])
}

model VacationQuota {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation("VacationQuotas", fields: [userId], references: [id], onDelete: Cascade)
  year      Int
  days      Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, year])
  @@index([year])
}

model Notification {
  id         String           @id @default(uuid())
  userId     String
  user       User             @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)
  type       NotificationType
  title      String
  body       String
  entityType String?
  entityId   String?
  href       String?
  read       Boolean          @default(false)
  createdAt  DateTime         @default(now())

  @@index([userId, read])
  @@index([userId, createdAt])
}

enum NotificationType {
  TASK_ASSIGNED
  TASK_COMMENT
  TASK_STATUS_CHANGED
  DEAL_CREATED
  DEAL_STAGE_CHANGED
  PROJECT_CREATED
  PHASE_COMPLETED
  BUDGET_WARNING
  APPOINTMENT_CREATED
  PERMIT_STATUS_CHANGED
  VACATION_REVIEWED
}

model NotificationPreference {
  id                     String   @id @default(uuid())
  userId                 String   @unique
  user                   User     @relation("NotificationPrefs", fields: [userId], references: [id], onDelete: Cascade)
  emailOnTaskAssigned    Boolean  @default(true)
  emailOnTaskComment     Boolean  @default(true)
  emailOnDealCreated     Boolean  @default(true)
  emailOnDealStageChange Boolean  @default(true)
  emailOnDueDate         Boolean  @default(true)
  emailOnFollowUp        Boolean  @default(true)
  emailOnPaymentDue      Boolean  @default(true)
  emailOnVacation        Boolean  @default(true)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
}

// ─── Follow-Up (globally visible reminders) ──────────────────────────────────

model FollowUp {
  id               String         @id @default(uuid())
  entityType       String         // 'deal', 'project', 'contact', 'task'
  entityId         String
  title            String
  description      String?
  dueDate          DateTime
  completed        Boolean        @default(false)
  completedAt      DateTime?
  assignedToUserId String?
  assignedTo       User?          @relation("FollowUpAssignee", fields: [assignedToUserId], references: [id])
  createdByUserId  String
  createdBy        User           @relation("FollowUpCreator", fields: [createdByUserId], references: [id])
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([entityType, entityId])
  @@index([assignedToUserId])
  @@index([dueDate])
  @@index([completed])
}

model EmailLog {
  id             String         @id @default(uuid())
  subject        String
  body           String?
  direction      EmailDirection @default(OUTBOUND)
  recipient      String?
  status         EmailLogStatus @default(SUCCESS)
  errorMessage   String?
  entityType     String?
  entityId       String?
  accountId      String?
  account        Account?       @relation(fields: [accountId], references: [id], onDelete: SetNull)
  contactId      String?
  contact        Contact?       @relation(fields: [contactId], references: [id], onDelete: SetNull)
  loggedByUserId String
  loggedBy       User           @relation("EmailLogCreator", fields: [loggedByUserId], references: [id])
  loggedAt       DateTime       @default(now())

  @@index([status])
  @@index([entityType, entityId])
}

enum EmailLogStatus {
  SUCCESS
  FAILED
}

enum EmailDirection {
  INBOUND
  OUTBOUND
}

model Appointment {
  id              String   @id @default(uuid())
  title           String
  description     String?
  startAt         DateTime
  endAt           DateTime
  accountId       String?
  account         Account? @relation(fields: [accountId], references: [id], onDelete: SetNull)
  contactId       String?
  contact         Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  dealId          String?
  deal            Deal?    @relation(fields: [dealId], references: [id], onDelete: SetNull)
  createdByUserId String
  creator         User     @relation("AppointmentCreator", fields: [createdByUserId], references: [id])
  assigneeUserId  String?
  assignee        User?    @relation("AppointmentAssignee", fields: [assigneeUserId], references: [id])
  recurrence      String?  // NONE, DAILY, WEEKLY, BIWEEKLY, MONTHLY
  recurrenceEnd   DateTime?
  parentId        String?
  parent          Appointment? @relation("RecurringAppointments", fields: [parentId], references: [id], onDelete: SetNull)
  children        Appointment[] @relation("RecurringAppointments")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([startAt])
  @@index([createdByUserId])
  @@index([parentId])
  @@index([assigneeUserId])
}

model Attachment {
  id               String   @id @default(uuid())
  dealId           String
  deal             Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  url              String
  filename         String
  mimeType         String?
  size             Int?
  uploadedByUserId String
  uploadedBy       User     @relation("uploadedBy", fields: [uploadedByUserId], references: [id])
  createdAt        DateTime @default(now())
}

model Note {
  id              String   @id @default(uuid())
  dealId          String?
  deal            Deal?    @relation(fields: [dealId], references: [id], onDelete: Cascade)
  contactId       String?
  contact         Contact? @relation(fields: [contactId], references: [id], onDelete: Cascade)
  accountId       String?
  account         Account? @relation(fields: [accountId], references: [id], onDelete: Cascade)
  content         String
  createdByUserId String
  createdBy       User     @relation("createdBy", fields: [createdByUserId], references: [id])
  createdAt       DateTime @default(now())

  @@index([contactId])
  @@index([accountId])
}

model Comment {
  id        String   @id @default(uuid())
  taskId    String
  task      Task     @relation("TaskComments", fields: [taskId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation("UserComments", fields: [authorId], references: [id])
  text      String
  createdAt DateTime @default(now())
}

model TaskHistory {
  id        String   @id @default(uuid())
  taskId    String
  task      Task     @relation("TaskHistory", fields: [taskId], references: [id], onDelete: Cascade)
  action    String
  payload   Json?
  createdAt DateTime @default(now())
  userId    String
  user      User     @relation("UserTaskHistory", fields: [userId], references: [id])
}

// This is the main Prisma schema for the CRM system
// It covers all required entities and relationships

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                   String                  @id @default(uuid())
  email                String                  @unique
  passwordHash         String
  name                 String
  role                 Role
  lastLoginAt          DateTime?
  pensumPercent        Int?
  hoursPerWeek         Float?
  hoursPerYear         Float?
  vacationDaysYearly   Int?
  createdAt            DateTime                @default(now())
  accounts             Account[]               @relation("AccountOwner")
  createdAccounts      Account[]               @relation("AccountCreator")
  deals                Deal[]                  @relation("DealOwner")
  createdDeals         Deal[]                  @relation("DealCreator")
  assignedTasks        Task[]                  @relation("TaskAssignee")
  createdTasks         Task[]                  @relation("TaskCreator")
  timeEntries          TimeEntry[]
  runningTimer         RunningTimer?
  activities           Activity[]              @relation("ActivityActor")
  dailyTimeByUser      DailyTimeByUser[]
  dealStageHistories   DealStageHistory[]
  comments             Comment[]               @relation("UserComments")
  taskHistory          TaskHistory[]           @relation("UserTaskHistory")
  uploadedAttachments  Attachment[]            @relation("uploadedBy")
  createdNotes         Note[]                  @relation("createdBy")
  appointments         Appointment[]           @relation("AppointmentCreator")
  assignedAppointments Appointment[]           @relation("AppointmentAssignee")
  emailLogs            EmailLog[]              @relation("EmailLogCreator")
  vacationRequests     VacationRequest[]       @relation("VacationRequests")
  reviewedVacations    VacationRequest[]       @relation("VacationReviewer")
  vacationQuotas       VacationQuota[]         @relation("VacationQuotas")
  passwordResetTokens  PasswordResetToken[]    @relation("PasswordResetTokens")
  ownedProjects        Project[]               @relation("ProjectOwner")
  createdProjects      Project[]               @relation("ProjectCreator")
  projectMemberships   ProjectMember[]         @relation("ProjectMembers")
  completedPhases      ProjectPhase[]          @relation("PhaseCompletedBy")
  createdPermits       Permit[]                @relation("PermitCreator")
  permitHistories      PermitHistory[]         @relation("PermitHistoryActor")
  createdVendors       Vendor[]                @relation("VendorCreator")
  budgetItems          BudgetItem[]            @relation("BudgetItemCreator")
  projectDocuments     ProjectDocument[]       @relation("DocumentUploader")
  taskDocuments        TaskDocument[]          @relation("TaskDocUploader")
  projectShares        ProjectShare[]          @relation("ShareCreator")
  notifications        Notification[]          @relation("UserNotifications")
  notificationPrefs    NotificationPreference? @relation("NotificationPrefs")
  dealPhases           DealPhase[]             @relation("DealPhaseResponsible")
  createdFollowUps     FollowUp[]              @relation("FollowUpCreator")
  assignedFollowUps    FollowUp[]              @relation("FollowUpAssignee")
}

enum Role {
  ADMIN
  PROJEKTLEITER
  MITARBEITER
  EXTERN
  USER // kept for backward compatibility, treated as MITARBEITER
}

model Account {
  id                 String               @id @default(uuid())
  name               String
  type               AccountType
  address            String?
  addressStreet      String?
  addressNumber      String?
  addressZip         String?
  addressCity        String?
  addressCanton      String?
  phone              String?
  email              String?
  notes              String?
  ownerUserId        String?
  owner              User?                @relation("AccountOwner", fields: [ownerUserId], references: [id])
  createdByUserId    String
  creator            User                 @relation("AccountCreator", fields: [createdByUserId], references: [id])
  contacts           Contact[]
  deals              Deal[]
  tasks              Task[]
  timeEntries        TimeEntry[]
  runningTimers      RunningTimer[]
  appointments       Appointment[]
  emailLogs          EmailLog[]
  projects           Project[]
  projectSuppliers   ProjectSupplier[]
  vendorType         VendorType?
  rating             Int?
  contactPerson      String?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  dailyTimeByAccount DailyTimeByAccount[]
  noteThreads        Note[]

  @@unique([name])
  @@index([ownerUserId])
  @@index([createdByUserId])
  @@index([type])
}

enum AccountType {
  CLIENT
  POTENTIAL_CLIENT
  PARTNER
  SUPPLIER
}

enum Currency {
  CHF
  EUR
}

model Contact {
  id           String        @id @default(uuid())
  accountId    String?
  account      Account?      @relation(fields: [accountId], references: [id], onDelete: SetNull)
  name         String
  email        String
  phone        String?
  title        String?
  notes        String?
  followUpDate DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  tasks        Task[]
  appointments Appointment[]
  emailLogs    EmailLog[]
  dealContacts DealContact[]
  noteThreads  Note[]

  @@index([accountId])
  @@index([followUpDate])
}

model DealContact {
  id        String   @id @default(uuid())
  dealId    String
  deal      Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  contactId String
  contact   Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([dealId, contactId])
  @@index([dealId])
  @@index([contactId])
}

model DealStage {
  id            String             @id @default(uuid())
  name          String
  order         Int
  isWon         Boolean            @default(false)
  isLost        Boolean            @default(false)
  deals         Deal[]
  histories     DealStageHistory[] @relation("ToStage")
  fromHistories DealStageHistory[] @relation("FromStage")
}

model Deal {
  id                String             @id @default(uuid())
  accountId         String
  account           Account            @relation(fields: [accountId], references: [id], onDelete: Cascade)
  name              String
  stageId           String
  stage             DealStage          @relation(fields: [stageId], references: [id])
  amount            Float
  currency          Currency           @default(CHF)
  expectedCloseDate DateTime
  followUpDate      DateTime?
  phases            Json? // SIA Leistungsphasen array, e.g. [31, 52]
  phaseBudgets      Json? // Hour budgets per phase, e.g. {"31.1": 40, "52": 100}
  customFields      Json? // Flexible custom fields per deal
  ownerUserId       String?
  owner             User?              @relation("DealOwner", fields: [ownerUserId], references: [id])
  createdByUserId   String
  creator           User               @relation("DealCreator", fields: [createdByUserId], references: [id])
  tasks             Task[]
  attachments       Attachment[]
  notes             Note[]
  stageHistories    DealStageHistory[]
  appointments      Appointment[]
  dealPhases        DealPhase[]
  dealContacts      DealContact[]
  project           Project?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([stageId])
  @@index([accountId])
  @@index([ownerUserId])
  @@index([createdByUserId])
  @@index([followUpDate])
  @@index([expectedCloseDate])
}

model DealStageHistory {
  id              String     @id @default(uuid())
  dealId          String
  deal            Deal       @relation(fields: [dealId], references: [id], onDelete: Cascade)
  fromStageId     String?
  toStageId       String
  toStage         DealStage  @relation("ToStage", fields: [toStageId], references: [id])
  fromStage       DealStage? @relation("FromStage", fields: [fromStageId], references: [id])
  changedByUserId String
  changedBy       User       @relation(fields: [changedByUserId], references: [id])
  changedAt       DateTime   @default(now())
}

model DealPhase {
  id                String             @id @default(uuid())
  dealId            String
  deal              Deal               @relation(fields: [dealId], references: [id], onDelete: Cascade)
  code              String
  name              String
  description       String?
  order             Int
  parentId          String?
  parent            DealPhase?         @relation("PhaseChildren", fields: [parentId], references: [id], onDelete: Cascade)
  children          DealPhase[]        @relation("PhaseChildren")
  hourBudget        Float?
  budgetChf         Float?
  offeredHours      Float?
  status            DealPhaseStatus    @default(PENDING)
  dueDate           DateTime?
  notes             String?
  responsibleUserId String?
  responsible       User?              @relation("DealPhaseResponsible", fields: [responsibleUserId], references: [id])
  payments          DealPhasePayment[]
  projectPhases     ProjectPhase[]     @relation("DealPhaseToProjectPhase")
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([dealId])
  @@index([parentId])
  @@index([responsibleUserId])
  @@index([dueDate])
}

enum DealPhaseStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  ON_HOLD
}

model DealPhasePayment {
  id           String    @id @default(uuid())
  dealPhaseId  String
  dealPhase    DealPhase @relation(fields: [dealPhaseId], references: [id], onDelete: Cascade)
  label        String
  amount       Float?
  percentage   Float?
  dueDate      DateTime?
  reminderSent Boolean   @default(false)
  createdAt    DateTime  @default(now())

  @@index([dealPhaseId])
  @@index([dueDate])
}

model DealSubPhaseTemplate {
  id              String   @id @default(uuid())
  parentCode      String
  name            String
  order           Int
  createdByUserId String
  createdAt       DateTime @default(now())

  @@index([parentCode])
}

model Task {
  id               String            @id @default(uuid())
  linkedFromPhase  ProjectPhase?     @relation("PhaseLinkedTask")
  title            String
  description      String?
  status           TaskStatus
  priority         TaskPriority
  dueDate          DateTime?
  assignedToUserId String?
  assignee         User?             @relation("TaskAssignee", fields: [assignedToUserId], references: [id])
  createdByUserId  String
  creator          User              @relation("TaskCreator", fields: [createdByUserId], references: [id])
  accountId        String?
  account          Account?          @relation(fields: [accountId], references: [id], onDelete: SetNull)
  contactId        String?
  contact          Contact?          @relation(fields: [contactId], references: [id], onDelete: SetNull)
  // already has activities and dailyTimeByTask
  dealId           String?
  deal             Deal?             @relation(fields: [dealId], references: [id], onDelete: SetNull)
  projectId        String?
  project          Project?          @relation("ProjectTasks", fields: [projectId], references: [id], onDelete: SetNull)
  phase            String? // SIA Leistungsphase code e.g. "31.1", "52"
  specification    String? // Free text specification
  assigneeIds      Json? // Additional assignee user IDs array
  budgetHours      Float? // Hour budget for this task
  checklists       Json? // Array of { id, title, items: [{ id, text, done }] }
  documents        TaskDocument[]
  timeEntries      TimeEntry[]
  runningTimers    RunningTimer[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  dailyTimeByTask  DailyTimeByTask[]
  comments         Comment[]         @relation("TaskComments")
  history          TaskHistory[]     @relation("TaskHistory")
  estimate         Int?

  @@index([status])
  @@index([dueDate])
  @@index([assignedToUserId])
  @@index([createdByUserId])
  @@index([accountId])
}

model TaskDocument {
  id               String   @id @default(uuid())
  taskId           String
  task             Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  name             String
  url              String
  mimeType         String?
  size             Int?
  category         String?
  uploadedByUserId String
  uploadedBy       User     @relation("TaskDocUploader", fields: [uploadedByUserId], references: [id])
  createdAt        DateTime @default(now())

  @@index([taskId])
}

enum TaskStatus {
  OPEN
  IN_PROGRESS
  DONE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model TimeEntry {
  id              String        @id @default(uuid())
  userId          String
  user            User          @relation(fields: [userId], references: [id])
  accountId       String
  account         Account       @relation(fields: [accountId], references: [id], onDelete: Cascade)
  taskId          String?
  task            Task?         @relation(fields: [taskId], references: [id], onDelete: SetNull)
  projectId       String?
  project         Project?      @relation(fields: [projectId], references: [id], onDelete: SetNull)
  projectPhaseId  String?
  projectPhase    ProjectPhase? @relation(fields: [projectPhaseId], references: [id], onDelete: SetNull)
  startedAt       DateTime
  endedAt         DateTime
  durationMinutes Int
  phase           String?
  description     String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([userId, startedAt])
  @@index([accountId, startedAt])
  @@index([projectPhaseId])
}

model RunningTimer {
  id             String        @id @default(uuid())
  userId         String        @unique
  user           User          @relation(fields: [userId], references: [id])
  accountId      String
  account        Account       @relation(fields: [accountId], references: [id], onDelete: Cascade)
  taskId         String?
  task           Task?         @relation(fields: [taskId], references: [id], onDelete: SetNull)
  projectId      String?
  project        Project?      @relation(fields: [projectId], references: [id], onDelete: SetNull)
  projectPhaseId String?
  projectPhase   ProjectPhase? @relation(fields: [projectPhaseId], references: [id], onDelete: SetNull)
  startedAt      DateTime
  description    String?
}

model Activity {
  id          String   @id @default(uuid())
  actorUserId String
  actor       User     @relation("ActivityActor", fields: [actorUserId], references: [id])
  entityType  String
  entityId    String
  action      String
  payloadJson Json
  createdAt   DateTime @default(now())

  // Relations for filtering
  // No foreign keys for entityId (polymorphic reference)
  @@index([entityType, entityId])
  @@index([createdAt])
}

// Optional: Daily Aggregates
model DailyTimeByUser {
  date         DateTime
  userId       String
  user         User     @relation(fields: [userId], references: [id])
  totalMinutes Int

  @@id([date, userId])
}

model DailyTimeByAccount {
  date         DateTime
  accountId    String
  account      Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  totalMinutes Int

  @@id([date, accountId])
}

model DailyTimeByTask {
  date         DateTime
  taskId       String
  task         Task     @relation(fields: [taskId], references: [id])
  totalMinutes Int

  @@id([date, taskId])
}

// ─── Project Phase Tracker ───────────────────────────────────────────────────

model Project {
  id              String             @id @default(uuid())
  name            String
  description     String?
  status          ProjectStatus      @default(ACTIVE)
  type            ProjectType        @default(ARCHITECTURE)
  address         String
  budget          Float?
  budgetHours     Float?
  currency        Currency           @default(CHF)
  startDate       DateTime?
  expectedEndDate DateTime?
  actualEndDate   DateTime?
  notes           String?
  accountId       String?
  account         Account?           @relation(fields: [accountId], references: [id], onDelete: SetNull)
  dealId          String?            @unique
  deal            Deal?              @relation(fields: [dealId], references: [id], onDelete: SetNull)
  ownerUserId     String
  owner           User               @relation("ProjectOwner", fields: [ownerUserId], references: [id])
  createdByUserId String
  creator         User               @relation("ProjectCreator", fields: [createdByUserId], references: [id])
  phases          ProjectPhase[]
  members         ProjectMember[]
  permits         Permit[]
  budgetItems     BudgetItem[]
  documents       ProjectDocument[]
  vendors         ProjectVendor[]
  suppliers       ProjectSupplier[]
  shares          ProjectShare[]
  timeEntries     TimeEntry[]
  runningTimers   RunningTimer[]
  tasks           Task[]             @relation("ProjectTasks")
  milestones      ProjectMilestone[]
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@index([ownerUserId])
  @@index([accountId])
  @@index([status])
}

model ProjectPhase {
  id                  String         @id @default(uuid())
  projectId           String
  project             Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name                String
  description         String?
  order               Int
  status              PhaseStatus    @default(PENDING)
  startDate           DateTime?
  endDate             DateTime?
  notes               String?
  budgetHours         Float?
  budgetChf           Float?
  offeredHours        Float?
  code                String?
  completedAt         DateTime?
  completedByUserId   String?
  completedBy         User?          @relation("PhaseCompletedBy", fields: [completedByUserId], references: [id])
  linkedTaskId        String?        @unique
  linkedTask          Task?          @relation("PhaseLinkedTask", fields: [linkedTaskId], references: [id])
  originDealPhaseId   String?
  originDealPhase     DealPhase?     @relation("DealPhaseToProjectPhase", fields: [originDealPhaseId], references: [id], onDelete: SetNull)
  timeEntries         TimeEntry[]
  runningTimers       RunningTimer[]
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  @@index([projectId])
  @@index([status])
  @@index([originDealPhaseId])
}

model ProjectMember {
  id        String   @id @default(uuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation("ProjectMembers", fields: [userId], references: [id])
  role      String?
  addedAt   DateTime @default(now())

  @@unique([projectId, userId])
  @@index([userId])
}

enum ProjectStatus {
  ACTIVE
  ON_HOLD
  COMPLETED
  CANCELLED
}

enum ProjectType {
  ARCHITECTURE
  INTERIOR_DESIGN
  CONSTRUCTION_MANAGEMENT
  VISUALIZATION
  REAL_ESTATE
  DIGITIZATION
  HOUSE
  APARTMENT
  RENOVATION
  COMMERCIAL
  CUSTOM
}

enum PhaseStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  SKIPPED
}

// ─── Project Templates (reusable starting points) ─────────────────────────────

model ProjectTemplate {
  id                  String      @id @default(uuid())
  name                String
  type                ProjectType
  description         String?
  defaultPhases       Json? // [{ name, description, order, budgetHours? }]
  defaultMilestoneIds Json? // [milestoneId, ...]
  defaultBudgetItems  Json? // [{ category, description, estimatedCost, phase? }]
  active              Boolean     @default(true)
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt
}

// ─── Construction Progress Milestones (Bauforschritt) ─────────────────────────

model ConstructionMilestone {
  id                String             @id @default(uuid())
  name              String
  order             Int
  isDefault         Boolean            @default(true)
  active            Boolean            @default(true)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  projectMilestones ProjectMilestone[]

  @@index([order])
}

model ProjectMilestone {
  id                String                @id @default(uuid())
  projectId         String
  project           Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  milestoneId       String
  milestone         ConstructionMilestone @relation(fields: [milestoneId], references: [id])
  order             Int
  completed         Boolean               @default(false)
  completedAt       DateTime?
  completedByUserId String?
  comment           String?

  @@unique([projectId, milestoneId])
  @@index([projectId])
}

// ─── Building Permit Pipeline ─────────────────────────────────────────────────

model Permit {
  id                 String          @id @default(uuid())
  projectId          String
  project            Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title              String
  authority          String?
  referenceNumber    String?
  status             PermitStatus    @default(VORBEREITUNG)
  submittedAt        DateTime?
  expectedDecisionAt DateTime?
  decidedAt          DateTime?
  notes              String?
  documents          Json?
  createdByUserId    String
  creator            User            @relation("PermitCreator", fields: [createdByUserId], references: [id])
  history            PermitHistory[]
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  @@index([projectId])
  @@index([status])
}

model PermitHistory {
  id          String        @id @default(uuid())
  permitId    String
  permit      Permit        @relation(fields: [permitId], references: [id], onDelete: Cascade)
  fromStatus  PermitStatus?
  toStatus    PermitStatus
  notes       String?
  actorUserId String
  actor       User          @relation("PermitHistoryActor", fields: [actorUserId], references: [id])
  createdAt   DateTime      @default(now())

  @@index([permitId])
}

enum PermitStatus {
  VORBEREITUNG
  EINGEREICHT
  IN_PRUEFUNG
  NACHFORDERUNG
  BEWILLIGT
  ABGELEHNT
  ZURUECKGEZOGEN
}

// ─── Vendor / Subcontractor Directory ────────────────────────────────────────

model Vendor {
  id              String          @id @default(uuid())
  name            String
  type            VendorType      @default(SONSTIGES)
  contactName     String?
  phone           String?
  email           String?
  address         String?
  notes           String?
  rating          Int?
  createdByUserId String
  creator         User            @relation("VendorCreator", fields: [createdByUserId], references: [id])
  projects        ProjectVendor[]
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([type])
}

model ProjectVendor {
  id         String   @id @default(uuid())
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  vendorId   String
  vendor     Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  phase      String?
  notes      String?
  assignedAt DateTime @default(now())

  @@unique([projectId, vendorId])
  @@index([vendorId])
}

model ProjectSupplier {
  id         String   @id @default(uuid())
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  accountId  String
  account    Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  phase      String?
  notes      String?
  assignedAt DateTime @default(now())

  @@unique([projectId, accountId])
  @@index([accountId])
}

enum VendorType {
  ARCHITEKT
  BAUINGENIEUR
  ELEKTRIKER
  SANITAER
  HEIZUNG_LUEFTUNG
  MALER
  ZIMMERMANN
  DACHDECKER
  GARTENBAU
  GENERALUNTERNEHMER
  SONSTIGES
}

// ─── Budget & Cost Tracking ───────────────────────────────────────────────────

model BudgetItem {
  id              String         @id @default(uuid())
  projectId       String
  project         Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  category        BudgetCategory @default(SONSTIGES)
  description     String
  estimatedCost   Float          @default(0)
  actualCost      Float?
  phase           String?
  notes           String?
  createdByUserId String
  creator         User           @relation("BudgetItemCreator", fields: [createdByUserId], references: [id])
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([projectId])
  @@index([category])
}

enum BudgetCategory {
  HONORARE
  ROHBAU
  ELEKTRO
  SANITAER
  HEIZUNG
  FASSADE
  DACH
  INNENAUSBAU
  UMGEBUNG
  RESERVE
  SONSTIGES
}

// ─── Document Vault ───────────────────────────────────────────────────────────

model ProjectDocument {
  id               String           @id @default(uuid())
  projectId        String
  project          Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name             String
  url              String
  category         DocumentCategory @default(SONSTIGES)
  version          String?
  notes            String?
  uploadedByUserId String
  uploadedBy       User             @relation("DocumentUploader", fields: [uploadedByUserId], references: [id])
  createdAt        DateTime         @default(now())

  @@index([projectId])
  @@index([category])
}

enum DocumentCategory {
  GRUNDRISS
  SCHNITT
  ANSICHT
  BAUGESUCH
  VERTRAG
  OFFERTE
  RECHNUNG
  PROTOKOLL
  FOTO
  SONSTIGES
}

// ─── Client Share Link ────────────────────────────────────────────────────────

model ProjectShare {
  id              String    @id @default(uuid())
  projectId       String
  project         Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  token           String    @unique @default(uuid())
  label           String?
  expiresAt       DateTime?
  createdByUserId String
  creator         User      @relation("ShareCreator", fields: [createdByUserId], references: [id])
  createdAt       DateTime  @default(now())

  @@index([projectId])
  @@index([token])
}
